RUNNING = True
LOGGER: "EventLogger | None" = None


def log(message: str) -> None:
    if LOGGER is not None:
        LOGGER.emit("info", "message", message)
        return
    print(message, flush=True)


def warn(message: str) -> None:
    if LOGGER is not None:
        LOGGER.emit("warning", "warning", message)
        return
    print(f"WARNING: {message}", file=sys.stderr, flush=True)


class EventLogger:
    def __init__(self, log_file: Path | None, journal_format: str) -> None:
        self.log_file = log_file
        self.journal_format = journal_format

    def emit(self, level: str, event: str, message: str, **fields: Any) -> None:
        now = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
        record: dict[str, Any] = {
            "ts": now,
            "level": level,
            "event": event,
            "message": message,
        }
        for key, value in fields.items():
            if value is None:
                continue
            record[key] = value

        if self.journal_format == "json":
            line = json.dumps(record, sort_keys=True, separators=(",", ":"))
        else:
            line = self.format_kv(record)

        stream = sys.stderr if level in {"warning", "error"} else sys.stdout
        print(line, file=stream, flush=True)

        if self.log_file is not None:
            try:
                self.log_file.parent.mkdir(parents=True, exist_ok=True)
                with self.log_file.open("a", encoding="utf-8") as handle:
                    handle.write(json.dumps(record, sort_keys=True, separators=(",", ":")) + "\n")
            except OSError as exc:
                print(f"WARNING: failed to write reputation log {self.log_file}: {exc}", file=sys.stderr, flush=True)

    @staticmethod
    def format_kv(record: dict[str, Any]) -> str:
        parts: list[str] = []
        for key, value in record.items():
            rendered = str(value)
            if re.search(r"\s|[\"'=]", rendered):
                rendered = shlex.quote(rendered)
            parts.append(f"{key}={rendered}")
        return " ".join(parts)


def audit(level: str, event: str, message: str, **fields: Any) -> None:
    if LOGGER is not None:
        LOGGER.emit(level, event, message, **fields)
        return
    prefix = "WARNING: " if level in {"warning", "error"} else ""
    print(prefix + message, file=sys.stderr if level in {"warning", "error"} else sys.stdout, flush=True)


def handle_signal(signum: int, _frame: Any) -> None:
    global RUNNING
    RUNNING = False
    log(f"received signal {signum}; stopping")


