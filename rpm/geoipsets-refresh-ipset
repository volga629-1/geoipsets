#!/usr/bin/bash
set -euo pipefail

legacy=false
provider="dbip"

while (( $# > 0 )); do
    case "$1" in
        --legacy)
            legacy=true
            ;;
        --provider)
            if (( $# < 2 )); then
                echo "ERROR: --provider requires a value" >&2
                exit 2
            fi
            provider="$2"
            shift
            ;;
        --help|-h)
            echo "Usage: ${0##*/} [--legacy] [--provider PROVIDER]" >&2
            exit 0
            ;;
        *)
            provider="$1"
            ;;
    esac
    shift
done

base_dir="/var/lib/geoipsets/${provider}/ipset"

if [[ ! -d "${base_dir}" ]]; then
    echo "No ipset data directory found: ${base_dir}" >&2
    exit 0
fi

shopt -s nullglob
files=("${base_dir}"/ipv4/*.ipv4 "${base_dir}"/ipv6/*.ipv6)

if (( ${#files[@]} == 0 )); then
    echo "No ipset files found under ${base_dir}" >&2
    exit 0
fi

set_supports_comment() {
    local set_name="$1"
    ipset list "${set_name}" | grep -qw 'comment'
}

restore_existing_set() {
    local set_name="$1"
    local file="$2"
    local source_pattern="$3"
    local temp_set="${set_name}_tmp_$$"

    ipset destroy "${temp_set}" >/dev/null 2>&1 || true

    if set_supports_comment "${set_name}"; then
        sed -E "s/^((create|add)[[:space:]]+)${source_pattern}([[:space:]]|$)/\\1${temp_set}\\3/" "${file}" \
            | ipset restore -exist
    else
        sed -E "s/^((create|add)[[:space:]]+)${source_pattern}([[:space:]]|$)/\\1${temp_set}\\3/" "${file}" \
            | sed -E 's/[[:space:]]+comment([[:space:]][^[:space:]]+)?$//' \
            | ipset restore -exist
    fi

    ipset swap "${temp_set}" "${set_name}"
    ipset destroy "${temp_set}"
}

for file in "${files[@]}"; do
    source_name="$(basename "${file}")"

    if [[ "${legacy}" == true ]]; then
        country="${source_name%%.*}"
        family="${source_name##*.}"
        set_name="${family}_${country}"
        source_pattern="${source_name//./\\.}"

        if ipset list "${set_name}" >/dev/null 2>&1; then
            restore_existing_set "${set_name}" "${file}" "${source_pattern}"
        else
            sed -E "s/^((create|add)[[:space:]]+)${source_pattern}([[:space:]]|$)/\\1${set_name}\\3/" "${file}" \
                | ipset restore -exist
        fi
    else
        set_name="${source_name}"
        source_pattern="${source_name//./\\.}"

        if ipset list "${set_name}" >/dev/null 2>&1; then
            restore_existing_set "${set_name}" "${file}" "${source_pattern}"
        else
            ipset restore -exist -file "${file}"
        fi
    fi
done
