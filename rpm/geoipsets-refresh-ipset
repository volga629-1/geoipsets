#!/usr/bin/bash
set -euo pipefail

legacy=false
provider="dbip"
maxelem=131072

while (( $# > 0 )); do
    case "$1" in
        --legacy)
            legacy=true
            ;;
        --maxelem)
            if (( $# < 2 )); then
                echo "ERROR: --maxelem requires a value" >&2
                exit 2
            fi
            maxelem="$2"
            shift
            ;;
        --provider)
            if (( $# < 2 )); then
                echo "ERROR: --provider requires a value" >&2
                exit 2
            fi
            provider="$2"
            shift
            ;;
        --help|-h)
            echo "Usage: ${0##*/} [--legacy] [--provider PROVIDER] [--maxelem MINIMUM]" >&2
            exit 0
            ;;
        *)
            provider="$1"
            ;;
    esac
    shift
done

if [[ ! "${maxelem}" =~ ^[0-9]+$ ]] || (( maxelem < 1 )); then
    echo "ERROR: --maxelem must be a positive integer" >&2
    exit 2
fi

base_dir="/var/lib/geoipsets/${provider}/ipset"

if [[ ! -d "${base_dir}" ]]; then
    echo "No ipset data directory found: ${base_dir}" >&2
    exit 0
fi

shopt -s nullglob
files=("${base_dir}"/ipv4/*.ipv4 "${base_dir}"/ipv6/*.ipv6)

if (( ${#files[@]} == 0 )); then
    echo "No ipset files found under ${base_dir}" >&2
    exit 0
fi

set_supports_comment() {
    local set_name="$1"
    ipset list "${set_name}" | grep -qw 'comment'
}

count_entries() {
    local file="$1"
    local count

    count="$(grep -c '^[[:space:]]*add[[:space:]]' "${file}" || true)"
    printf '%s' "${count//[[:space:]]/}"
}

calculate_maxelem() {
    local entry_count="$1"
    local minimum="$2"
    local autosized

    autosized=$((entry_count + ((entry_count + 3) / 4)))

    if (( autosized < minimum )); then
        printf '%s' "${minimum}"
    else
        printf '%s' "${autosized}"
    fi
}

rewrite_create_maxelem() {
    local restore_file="$1"
    local set_maxelem="$2"
    local rewritten

    rewritten="$(mktemp)"

    awk -v maxelem="${set_maxelem}" '
        /^[[:space:]]*create[[:space:]]/ {
            if ($0 ~ /[[:space:]]maxelem[[:space:]][0-9]+/) {
                sub(/[[:space:]]maxelem[[:space:]][0-9]+/, " maxelem " maxelem)
            } else if ($0 ~ /[[:space:]]comment([[:space:]]|$)/) {
                sub(/[[:space:]]comment([[:space:]]|$)/, " maxelem " maxelem " comment ")
            } else {
                $0 = $0 " maxelem " maxelem
            }
        }
        { print }
    ' "${restore_file}" > "${rewritten}"

    mv "${rewritten}" "${restore_file}"
}

prepare_restore_file() {
    local set_name="$1"
    local file="$2"
    local source_pattern="$3"
    local strip_comment="$4"
    local restore_file
    local stripped
    local entry_count
    local set_maxelem

    restore_file="$(mktemp)"

    sed -E "s/^((create|add)[[:space:]]+)${source_pattern}([[:space:]]|$)/\\1${set_name}\\3/" "${file}" > "${restore_file}"

    if [[ "${strip_comment}" == true ]]; then
        stripped="$(mktemp)"
        sed -E 's/[[:space:]]+comment([[:space:]][^[:space:]]+)?$//' "${restore_file}" > "${stripped}"
        mv "${stripped}" "${restore_file}"
    fi

    entry_count="$(count_entries "${restore_file}")"
    set_maxelem="$(calculate_maxelem "${entry_count}" "${maxelem}")"
    rewrite_create_maxelem "${restore_file}" "${set_maxelem}"

    echo "Prepared ${set_name}: entries=${entry_count} maxelem=${set_maxelem}" >&2
    printf '%s' "${restore_file}"
}

restore_set() {
    local set_name="$1"
    local file="$2"
    local source_pattern="$3"
    local existing="$4"
    local strip_comment=false
    local temp_set="${set_name}_tmp_$$"
    local restore_name="${set_name}"
    local restore_file

    if [[ "${existing}" == true ]]; then
        ipset destroy "${temp_set}" >/dev/null 2>&1 || true
        restore_name="${temp_set}"

        if ! set_supports_comment "${set_name}"; then
            strip_comment=true
        fi
    fi

    restore_file="$(prepare_restore_file "${restore_name}" "${file}" "${source_pattern}" "${strip_comment}")"

    if [[ "${existing}" == true ]]; then
        ipset restore -exist -file "${restore_file}"
        ipset swap "${temp_set}" "${set_name}"
        ipset destroy "${temp_set}"
    else
        ipset restore -exist -file "${restore_file}"
    fi

    rm -f "${restore_file}"
}

for file in "${files[@]}"; do
    source_name="$(basename "${file}")"

    if [[ "${legacy}" == true ]]; then
        country="${source_name%%.*}"
        family="${source_name##*.}"
        set_name="${family}_${country}"
        source_pattern="${source_name//./\\.}"

        if ipset list "${set_name}" >/dev/null 2>&1; then
            restore_set "${set_name}" "${file}" "${source_pattern}" true
        else
            restore_set "${set_name}" "${file}" "${source_pattern}" false
        fi
    else
        set_name="${source_name}"
        source_pattern="${source_name//./\\.}"

        if ipset list "${set_name}" >/dev/null 2>&1; then
            restore_set "${set_name}" "${file}" "${source_pattern}" true
        else
            restore_set "${set_name}" "${file}" "${source_pattern}" false
        fi
    fi
done
