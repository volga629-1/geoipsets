#!/usr/bin/bash
set -euo pipefail

config_file="/etc/geoipsets.blocklist-feeds.conf"
output_dir="/var/lib/geoipsets/blocklists/feeds"
curl_opts=(--fail --silent --show-error --location --connect-timeout 10 --max-time 120)
strict=false

while (( $# > 0 )); do
    case "$1" in
        --config)
            if (( $# < 2 )); then
                echo "ERROR: --config requires a value" >&2
                exit 2
            fi
            config_file="$2"
            shift
            ;;
        --output-dir)
            if (( $# < 2 )); then
                echo "ERROR: --output-dir requires a value" >&2
                exit 2
            fi
            output_dir="$2"
            shift
            ;;
        --strict)
            strict=true
            ;;
        --help|-h)
            echo "Usage: ${0##*/} [--config PATH] [--output-dir DIR] [--strict]" >&2
            exit 0
            ;;
        *)
            echo "ERROR: unknown option: $1" >&2
            exit 2
            ;;
    esac
    shift
done

if [[ ! -f "${config_file}" ]]; then
    echo "No dynamic blocklist feed config found: ${config_file}" >&2
    exit 0
fi

mkdir -p "${output_dir}"

tmp_files=()
cleanup() {
    local file
    for file in "${tmp_files[@]}"; do
        rm -f "${file}"
    done
}
trap cleanup EXIT

trim() {
    local value="$1"
    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"
    printf '%s' "${value}"
}

normalize_feed() {
    awk '
        {
            sub(/\r$/, "")
            line = $0
            sub(/#.*/, "", line)
            sub(/;.*/, "", line)
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", line)
            if (line == "") {
                next
            }

            count = split(line, fields, /[[:space:]]+/)
            for (i = 1; i <= count; i++) {
                if (fields[i] ~ /^([0-9]{1,3}\.){3}[0-9]{1,3}(\/[0-9]{1,2})?$/ ||
                    fields[i] ~ /^[0-9A-Fa-f:]*:[0-9A-Fa-f:]+(\/[0-9]{1,3})?$/) {
                    print fields[i]
                    next
                }
            }
        }
    ' | sort -u
}

fetch_feed() {
    local name="$1"
    local url="$2"
    local raw
    local normalized
    local destination="${output_dir}/${name}.list"

    raw="$(mktemp)"
    normalized="$(mktemp)"
    tmp_files+=("${raw}" "${normalized}")

    if ! curl "${curl_opts[@]}" "${url}" -o "${raw}"; then
        echo "WARNING: failed to fetch ${name}: ${url}" >&2
        return 1
    fi

    normalize_feed < "${raw}" > "${normalized}"
    install -pm 0644 "${normalized}" "${destination}"
    echo "Updated ${destination}"
}

failures=0
feeds=0
enabled_names=()

while IFS= read -r line || [[ -n "${line}" ]]; do
    line="${line%%#*}"
    line="$(trim "${line}")"

    [[ -z "${line}" ]] && continue
    [[ "${line}" =~ ^iplist[[:space:]]*\{?$ || "${line}" == "{" || "${line}" == "}" ]] && continue

    if [[ "${line}" =~ ^@([A-Za-z0-9_.-]+)[[:space:]]+([^[:space:]]+)$ ]]; then
        feeds=$((feeds + 1))
        enabled_names+=("${BASH_REMATCH[1]}")
        if ! fetch_feed "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"; then
            failures=$((failures + 1))
        fi
    else
        echo "WARNING: ignored invalid feed line: ${line}" >&2
        failures=$((failures + 1))
    fi
done < "${config_file}"

if (( feeds == 0 )); then
    echo "No dynamic blocklist feeds enabled in ${config_file}" >&2
fi

shopt -s nullglob
for file in "${output_dir}"/*.list; do
    name="${file##*/}"
    name="${name%.list}"
    enabled=false

    for enabled_name in "${enabled_names[@]}"; do
        if [[ "${name}" == "${enabled_name}" ]]; then
            enabled=true
            break
        fi
    done

    if [[ "${enabled}" == false ]]; then
        rm -f "${file}"
        echo "Removed disabled dynamic feed ${file}"
    fi
done

if (( failures > 0 )); then
    echo "WARNING: ${failures} dynamic blocklist feed(s) failed or were ignored" >&2
    [[ "${strict}" == false ]] || exit 1
fi
