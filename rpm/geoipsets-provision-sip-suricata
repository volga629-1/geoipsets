#!/usr/bin/bash
set -euo pipefail

suricata_yaml="${SURICATA_YAML:-/etc/suricata/suricata.yaml}"
update_yaml="${SURICATA_UPDATE_YAML:-/etc/suricata/update.yaml}"
rules_src="${RULES_SRC:-/usr/share/geoipsets/suricata/local-sip.rules}"
rules_dst="${RULES_DST:-}"
rules_bundle="${RULES_BUNDLE:-/var/lib/suricata/rules/suricata.rules}"
auto_disable_conf="${AUTO_DISABLE_CONF:-/var/lib/suricata/rules/geoipsets-disabled-protocols.disable.conf}"
ports="${SIP_PORTS:-5060 5061 5084 5086 5087 5088}"
mirror=false
update_rules=true
test_config=true
reload_suricata=false
auto_disable_protocol_rules=true
generated_auto_disable_conf=false

usage() {
    cat >&2 <<EOF
Usage: ${0##*/} [OPTIONS]

Install geoipsets local Suricata SIP rules and optionally restart the local
mirror interface.

Options:
  --mirror              Restart geoipsets-ifbctl after installing rules
  --reload             Reload Suricata after successful update/test
  --no-update          Do not run suricata-update
  --no-test            Do not run suricata -T
  --no-auto-disable    Do not generate disable rules for app-layer protocols
                       disabled in SURICATA_YAML
  --help, -h           Show this help

Environment:
  SIP_PORTS            Space-separated SIP ports. Default: ${ports}
  SURICATA_YAML        Suricata config path. Default: ${suricata_yaml}
  SURICATA_UPDATE_YAML Suricata Update config path. Default: ${update_yaml}
  RULES_SRC            Source rule file. Default: ${rules_src}
  RULES_DST            Destination rule file override. If unset, derive from
                       SURICATA_UPDATE_YAML local rule paths.
  RULES_BUNDLE         Merged rules file. Default: ${rules_bundle}
  AUTO_DISABLE_CONF    Generated Suricata Update disable-conf path. Default:
                       ${auto_disable_conf}
  WAN_IF               Passed to geoipsets-ifbctl when --mirror is used
  MIRROR_IF            Passed to geoipsets-ifbctl when --mirror is used
  MIRROR_TYPE          Passed to geoipsets-ifbctl when --mirror is used
  MIRROR_QLEN          Passed to geoipsets-ifbctl when --mirror is used
EOF
}

while (( $# > 0 )); do
    case "$1" in
        --mirror)
            mirror=true
            ;;
        --reload)
            reload_suricata=true
            ;;
        --no-update)
            update_rules=false
            ;;
        --no-test)
            test_config=false
            ;;
        --no-auto-disable)
            auto_disable_protocol_rules=false
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        *)
            echo "ERROR: unknown option: $1" >&2
            usage
            exit 2
            ;;
    esac
    shift
done

require_root() {
    if (( EUID != 0 )); then
        echo "ERROR: ${0##*/} must run as root" >&2
        exit 1
    fi
}

has_command() {
    command -v "$1" >/dev/null 2>&1
}

suricata_update_supports_disable_conf() {
    suricata-update --help 2>&1 | grep -q -- '--disable-conf'
}

protocol_is_disabled() {
    local protocol="$1"

    [[ -f "${suricata_yaml}" ]] || return 1

    awk -v protocol="${protocol}" '
        function line_indent(value) {
            match(value, /[^ ]/)
            return RSTART ? RSTART - 1 : length(value)
        }

        {
            line = $0
            sub(/[[:space:]]+#.*/, "", line)

            if (line ~ "^[[:space:]]*" protocol ":[[:space:]]*$") {
                in_protocol = 1
                protocol_indent = line_indent(line)
                next
            }

            if (!in_protocol) {
                next
            }

            if (line ~ /^[[:space:]]*[[:alnum:]_-]+:[[:space:]]*/ && line_indent(line) <= protocol_indent) {
                exit
            }

            if (line ~ /^[[:space:]]*(enabled|detection-enabled):[[:space:]]*/) {
                value = line
                sub(/^[[:space:]]*(enabled|detection-enabled):[[:space:]]*/, "", value)
                gsub(/[[:space:]"\047]/, "", value)
                value = tolower(value)
                if (value ~ /^(no|false|0)$/) {
                    disabled = 1
                    exit
                }
            }
        }

        END {
            exit disabled ? 0 : 1
        }
    ' "${suricata_yaml}"
}

write_auto_disable_conf() {
    local disabled_protocols=()
    local protocol

    if [[ "${auto_disable_protocol_rules}" != true ]]; then
        return 0
    fi

    for protocol in ftp smtp tls; do
        if protocol_is_disabled "${protocol}"; then
            disabled_protocols+=("${protocol}")
        fi
    done

    if (( ${#disabled_protocols[@]} == 0 )); then
        return 0
    fi

    if ! suricata_update_supports_disable_conf; then
        echo "WARNING: suricata-update does not support --disable-conf; cannot auto-disable rules for disabled app-layer protocols: ${disabled_protocols[*]}" >&2
        return 0
    fi

    install -dpm 0755 "$(dirname "${auto_disable_conf}")"
    {
        echo "# Generated by geoipsets-provision-sip-suricata."
        echo "# Suricata has these app-layer protocols disabled locally, so rules"
        echo "# that declare them as the rule protocol are disabled before -T."
        for protocol in "${disabled_protocols[@]}"; do
            printf 're:^(alert|drop|reject|pass)\\s+%s\\s+\n' "${protocol}"
            if [[ "${protocol}" == "tls" ]]; then
                printf 're:tls\\.sni\n'
            fi
        done
    } >"${auto_disable_conf}"
    generated_auto_disable_conf=true

    echo "Generated ${auto_disable_conf} for disabled app-layer protocol rules: ${disabled_protocols[*]}"
}

derive_rules_dst_from_update_yaml() {
    if [[ ! -f "${update_yaml}" ]]; then
        return 1
    fi

    awk '
        function trim(value) {
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
            return value
        }

        /^local:[[:space:]]*$/ {
            in_local = 1
            next
        }

        in_local && /^[^[:space:]#][^:]*:[[:space:]]*/ {
            exit
        }

        in_local {
            line = $0
            sub(/[[:space:]]+#.*/, "", line)
            sub(/^[[:space:]]*-[[:space:]]*/, "", line)
            line = trim(line)
            gsub(/^["'\'']|["'\'']$/, "", line)
            if (line == "") {
                next
            }

            if (line ~ /(^|\/)local-sip\.rules$/) {
                print line
                exit
            }
            if (line ~ /\/\*\.rules$/) {
                sub(/\/\*\.rules$/, "/local-sip.rules", line)
                print line
                exit
            }
            if (line !~ /\.rules$/) {
                sub(/\/$/, "", line)
                print line "/local-sip.rules"
                exit
            }
        }
    ' "${update_yaml}"
}

resolve_rules_dst() {
    if [[ -n "${rules_dst}" ]]; then
        return 0
    fi

    rules_dst="$(derive_rules_dst_from_update_yaml || true)"

    if [[ -z "${rules_dst}" ]]; then
        rules_dst="/var/lib/suricata/rules/local-sip.rules"
        echo "WARNING: could not derive local rule path from ${update_yaml}; using ${rules_dst}" >&2
    else
        echo "Using local rule path from ${update_yaml}: ${rules_dst}"
    fi
}

print_sip_ports_hint() {
    cat >&2 <<EOF
WARNING: could not verify all SIP ports in ${suricata_yaml}.
Make sure Suricata has the same SIP_PORTS used by the mirror and worker:

vars:
  port-groups:
    SIP_PORTS: "[5060,5061,5084,5086,5087,5088]"
EOF
}

verify_sip_ports() {
    local missing=0
    local port

    if [[ ! -f "${suricata_yaml}" ]]; then
        echo "WARNING: missing Suricata config: ${suricata_yaml}" >&2
        return 0
    fi

    for port in ${ports}; do
        if ! grep -Eq "(^|[^0-9])${port}([^0-9]|$)" "${suricata_yaml}"; then
            missing=1
        fi
    done

    (( missing == 0 )) || print_sip_ports_hint
}

install_local_rules() {
    if [[ ! -f "${rules_src}" ]]; then
        echo "ERROR: missing local SIP rules source: ${rules_src}" >&2
        exit 1
    fi

    resolve_rules_dst
    install -Dpm 0644 "${rules_src}" "${rules_dst}"
    echo "Installed ${rules_dst}"
}

run_suricata_update() {
    local update_args=()

    if ! has_command suricata-update; then
        echo "WARNING: suricata-update not found; copy was completed but rules were not rebuilt" >&2
        return 0
    fi

    write_auto_disable_conf

    if [[ "${generated_auto_disable_conf}" == true ]] && [[ -s "${auto_disable_conf}" ]] && suricata_update_supports_disable_conf; then
        update_args+=(--disable-conf "${auto_disable_conf}")
    fi

    if [[ -f "${update_yaml}" ]]; then
        suricata-update -c "${update_yaml}" "${update_args[@]}"
    else
        echo "WARNING: missing Suricata Update config: ${update_yaml}; using suricata-update defaults" >&2
        suricata-update "${update_args[@]}"
    fi
}

verify_merged_rules() {
    if [[ ! -f "${rules_bundle}" ]]; then
        echo "WARNING: merged Suricata rules not found: ${rules_bundle}" >&2
        return 0
    fi

    if ! grep -q "GEOIPSETS SIP" "${rules_bundle}"; then
        echo "WARNING: ${rules_bundle} does not contain GEOIPSETS SIP rules; check update.yaml local rule paths" >&2
    fi

    if ! grep -q "ET DROP Dshield" "${rules_bundle}"; then
        echo "WARNING: ${rules_bundle} does not contain ET DShield rules; enable emerging-dshield.rules if desired" >&2
    fi
}

test_suricata_config() {
    if ! has_command suricata; then
        echo "WARNING: suricata not found; skipped config test" >&2
        return 0
    fi

    suricata -T -c "${suricata_yaml}"
}

reload_suricata_service() {
    if ! has_command systemctl; then
        echo "WARNING: systemctl not found; skipped Suricata reload" >&2
        return 0
    fi

    systemctl reload suricata.service || systemctl restart suricata.service
}

restart_mirror() {
    if ! has_command geoipsets-ifbctl; then
        echo "ERROR: geoipsets-ifbctl not found" >&2
        exit 1
    fi

    env \
        SIP_PORTS="${ports}" \
        WAN_IF="${WAN_IF:-}" \
        MIRROR_IF="${MIRROR_IF:-ifb-sip0}" \
        MIRROR_TYPE="${MIRROR_TYPE:-dummy}" \
        MIRROR_QLEN="${MIRROR_QLEN:-10000}" \
        geoipsets-ifbctl restart
}

require_root
install_local_rules
verify_sip_ports

if [[ "${update_rules}" == true ]]; then
    run_suricata_update
    verify_merged_rules
fi

if [[ "${test_config}" == true ]]; then
    test_suricata_config
fi

if [[ "${mirror}" == true ]]; then
    restart_mirror
fi

if [[ "${reload_suricata}" == true ]]; then
    reload_suricata_service
fi

echo "geoipsets SIP Suricata provisioning completed"
