# Local SIP signals for geoipsets reputation promotion.
#
# These rules alert only. The reputation worker decides whether to query APIs
# and promote the source to blocked_ipv4/blocked_ipv6.

alert udp $EXTERNAL_NET any -> $HOME_NET $SIP_PORTS (msg:"GEOIPSETS SIP scanner user-agent"; content:"User-Agent|3a|"; nocase; pcre:"/User-Agent\s*:\s*(friendly-scanner|sipvicious|sipsak|sundayddr|iWar|sipcli|VaxSIPUserAgent|eyeBeam)/Hi"; classtype:attempted-recon; sid:9002001; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET $SIP_PORTS (msg:"GEOIPSETS SIP scanner user-agent"; flow:stateless; content:"User-Agent|3a|"; nocase; pcre:"/User-Agent\s*:\s*(friendly-scanner|sipvicious|sipsak|sundayddr|iWar|sipcli|VaxSIPUserAgent|eyeBeam)/Hi"; classtype:attempted-recon; sid:9002002; rev:1;)

alert udp $EXTERNAL_NET any -> $HOME_NET $SIP_PORTS (msg:"GEOIPSETS SIP TUFAN scanner user-agent"; content:"User-Agent|3a|"; nocase; content:"TUFAN-Scanner"; nocase; classtype:attempted-recon; sid:9002091; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET $SIP_PORTS (msg:"GEOIPSETS SIP TUFAN scanner user-agent"; flow:stateless; content:"User-Agent|3a|"; nocase; content:"TUFAN-Scanner"; nocase; classtype:attempted-recon; sid:9002092; rev:1;)

alert udp $EXTERNAL_NET any -> $HOME_NET $SIP_PORTS (msg:"GEOIPSETS SIP TUFAN SDP call marker"; content:"INVITE sip:"; nocase; content:"s=TUFAN Call"; nocase; classtype:attempted-recon; sid:9002097; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET $SIP_PORTS (msg:"GEOIPSETS SIP TUFAN SDP call marker"; flow:stateless; content:"INVITE sip:"; nocase; content:"s=TUFAN Call"; nocase; classtype:attempted-recon; sid:9002098; rev:1;)

alert udp $EXTERNAL_NET any -> $HOME_NET $SIP_PORTS (msg:"GEOIPSETS SIP file URI probe"; content:"sip:file|3a|///"; nocase; classtype:attempted-recon; sid:9002093; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET $SIP_PORTS (msg:"GEOIPSETS SIP file URI probe"; flow:stateless; content:"sip:file|3a|///"; nocase; classtype:attempted-recon; sid:9002094; rev:1;)

alert udp $EXTERNAL_NET any -> $HOME_NET $SIP_PORTS (msg:"GEOIPSETS SIP path traversal URI probe"; content:"sip|3a|"; nocase; content:"../"; pcre:"/sip:(%00\/)?(\.\.\/)+/i"; classtype:attempted-recon; sid:9002095; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET $SIP_PORTS (msg:"GEOIPSETS SIP path traversal URI probe"; flow:stateless; content:"sip|3a|"; nocase; content:"../"; pcre:"/sip:(%00\/)?(\.\.\/)+/i"; classtype:attempted-recon; sid:9002096; rev:1;)

alert udp $EXTERNAL_NET any -> $HOME_NET $SIP_PORTS (msg:"GEOIPSETS SIP INVITE with private or CGNAT Contact"; content:"INVITE sip:"; nocase; content:"Contact|3a|"; nocase; pcre:"/Contact\s*:\s*.*@(10\.|192\.168\.|172\.(1[6-9]|2[0-9]|3[0-1])\.|100\.64\.)/Hi"; classtype:attempted-recon; sid:9002011; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET $SIP_PORTS (msg:"GEOIPSETS SIP INVITE with private or CGNAT Contact"; flow:stateless; content:"INVITE sip:"; nocase; content:"Contact|3a|"; nocase; pcre:"/Contact\s*:\s*.*@(10\.|192\.168\.|172\.(1[6-9]|2[0-9]|3[0-1])\.|100\.64\.)/Hi"; classtype:attempted-recon; sid:9002012; rev:1;)

alert udp $EXTERNAL_NET any -> $HOME_NET $SIP_PORTS (msg:"GEOIPSETS SIP SDP private or CGNAT media address"; content:"INVITE sip:"; nocase; pcre:"/\nc=IN IP4 (10\.|192\.168\.|172\.(1[6-9]|2[0-9]|3[0-1])\.|100\.64\.)/i"; classtype:attempted-recon; sid:9002021; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET $SIP_PORTS (msg:"GEOIPSETS SIP SDP private or CGNAT media address"; flow:stateless; content:"INVITE sip:"; nocase; pcre:"/\nc=IN IP4 (10\.|192\.168\.|172\.(1[6-9]|2[0-9]|3[0-1])\.|100\.64\.)/i"; classtype:attempted-recon; sid:9002022; rev:1;)

alert udp $EXTERNAL_NET any -> $HOME_NET $SIP_PORTS (msg:"GEOIPSETS SIP INVITE reputation check"; content:"INVITE sip:"; nocase; threshold:type both, track by_src, seconds 300, count 1; classtype:attempted-recon; sid:9002071; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET $SIP_PORTS (msg:"GEOIPSETS SIP INVITE reputation check"; flow:stateless; content:"INVITE sip:"; nocase; threshold:type both, track by_src, seconds 300, count 1; classtype:attempted-recon; sid:9002072; rev:1;)

alert udp $EXTERNAL_NET any -> $HOME_NET $SIP_PORTS (msg:"GEOIPSETS SIP long numeric INVITE probe"; content:"INVITE sip:"; nocase; pcre:"/^INVITE\s+sip:[0-9]{13,}@/Ri"; content:"Contact|3a|"; nocase; pcre:"/Contact\s*:\s*<sip:[0-9]{2,15}@[0-9]{1,3}\./i"; threshold:type both, track by_src, seconds 300, count 1; classtype:attempted-recon; sid:9002081; rev:2;)
alert tcp $EXTERNAL_NET any -> $HOME_NET $SIP_PORTS (msg:"GEOIPSETS SIP long numeric INVITE probe"; flow:stateless; content:"INVITE sip:"; nocase; pcre:"/^INVITE\s+sip:[0-9]{13,}@/Ri"; content:"Contact|3a|"; nocase; pcre:"/Contact\s*:\s*<sip:[0-9]{2,15}@[0-9]{1,3}\./i"; threshold:type both, track by_src, seconds 300, count 1; classtype:attempted-recon; sid:9002082; rev:2;)

alert udp $EXTERNAL_NET any -> $HOME_NET $SIP_PORTS (msg:"GEOIPSETS SIP repeated INVITE source"; content:"INVITE sip:"; nocase; detection_filter:track by_src,count 10,seconds 60; classtype:attempted-recon; sid:9002083; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET $SIP_PORTS (msg:"GEOIPSETS SIP repeated INVITE source"; flow:stateless; content:"INVITE sip:"; nocase; detection_filter:track by_src,count 10,seconds 60; classtype:attempted-recon; sid:9002084; rev:1;)

alert udp $EXTERNAL_NET any -> $HOME_NET $SIP_PORTS (msg:"GEOIPSETS SIP OPTIONS probe to numeric extension"; content:"OPTIONS sip:"; nocase; pcre:"/^OPTIONS\s+sip:[0-9]{2,8}@/Ri"; threshold:type both, track by_src, seconds 300, count 2; classtype:attempted-recon; sid:9002051; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET $SIP_PORTS (msg:"GEOIPSETS SIP OPTIONS probe to numeric extension"; flow:stateless; content:"OPTIONS sip:"; nocase; pcre:"/^OPTIONS\s+sip:[0-9]{2,8}@/Ri"; threshold:type both, track by_src, seconds 300, count 2; classtype:attempted-recon; sid:9002052; rev:1;)

alert udp $EXTERNAL_NET any -> $HOME_NET $SIP_PORTS (msg:"GEOIPSETS SIP REGISTER from public internet"; content:"REGISTER sip:"; nocase; threshold:type both, track by_src, seconds 300, count 3; classtype:attempted-recon; sid:9002061; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET $SIP_PORTS (msg:"GEOIPSETS SIP REGISTER from public internet"; flow:stateless; content:"REGISTER sip:"; nocase; threshold:type both, track by_src, seconds 300, count 3; classtype:attempted-recon; sid:9002062; rev:1;)
