#!/usr/bin/bash
set -euo pipefail

blocklist_file="/etc/geoipsets.blocklist"
blocklist_files=("${blocklist_file}")
blocklist_dirs=("/etc/geoipsets.blocklist.d" "/var/lib/geoipsets/blocklists" "/var/lib/geoipsets/blocklists/feeds")
ipv4_set="blocked_ipv4"
ipv6_set="blocked_ipv6"
maxelem=1048576

while (( $# > 0 )); do
    case "$1" in
        --file)
            if (( $# < 2 )); then
                echo "ERROR: --file requires a value" >&2
                exit 2
            fi
            blocklist_files=("$2")
            blocklist_dirs=()
            shift
            ;;
        --directory)
            if (( $# < 2 )); then
                echo "ERROR: --directory requires a value" >&2
                exit 2
            fi
            blocklist_dirs+=("$2")
            shift
            ;;
        --ipv4-set)
            if (( $# < 2 )); then
                echo "ERROR: --ipv4-set requires a value" >&2
                exit 2
            fi
            ipv4_set="$2"
            shift
            ;;
        --ipv6-set)
            if (( $# < 2 )); then
                echo "ERROR: --ipv6-set requires a value" >&2
                exit 2
            fi
            ipv6_set="$2"
            shift
            ;;
        --maxelem)
            if (( $# < 2 )); then
                echo "ERROR: --maxelem requires a value" >&2
                exit 2
            fi
            maxelem="$2"
            shift
            ;;
        --help|-h)
            echo "Usage: ${0##*/} [--file PATH] [--directory DIR] [--ipv4-set NAME] [--ipv6-set NAME] [--maxelem MINIMUM]" >&2
            exit 0
            ;;
        *)
            echo "ERROR: unknown option: $1" >&2
            exit 2
            ;;
    esac
    shift
done

if [[ ! "${maxelem}" =~ ^[0-9]+$ ]] || (( maxelem < 1 )); then
    echo "ERROR: --maxelem must be a positive integer" >&2
    exit 2
fi

tmp_ipv4="$(mktemp)"
tmp_ipv6="$(mktemp)"
tmp_ipv4_body="$(mktemp)"
tmp_ipv6_body="$(mktemp)"
temp_sets=()

cleanup() {
    local set_name

    rm -f "${tmp_ipv4}" "${tmp_ipv6}" "${tmp_ipv4_body}" "${tmp_ipv6_body}"

    for set_name in "${temp_sets[@]}"; do
        ipset destroy "${set_name}" >/dev/null 2>&1 || true
    done
}
trap cleanup EXIT

: > "${tmp_ipv4_body}"
: > "${tmp_ipv6_body}"

add_entry() {
    local entry="$1"

    if [[ "${entry}" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}(/[0-9]{1,2})?$ ]]; then
        printf 'add %s %s\n' "${ipv4_set}" "${entry}" >> "${tmp_ipv4_body}"
    elif [[ "${entry}" =~ ^[0-9A-Fa-f:]*:[0-9A-Fa-f:]+(/[0-9]{1,3})?$ ]]; then
        printf 'add %s %s\n' "${ipv6_set}" "${entry}" >> "${tmp_ipv6_body}"
    else
        echo "WARNING: ignored invalid blocklist entry: ${entry}" >&2
    fi
}

read_blocklist_file() {
    local file="$1"
    local line
    local entry

    [[ -f "${file}" ]] || return 0

    while IFS= read -r line || [[ -n "${line}" ]]; do
        entry="${line%%#*}"
        entry="${entry%%;*}"
        entry="${entry#"${entry%%[![:space:]]*}"}"
        entry="${entry%"${entry##*[![:space:]]}"}"

        [[ -z "${entry}" ]] && continue
        add_entry "${entry}"
    done < "${file}"
}

for file in "${blocklist_files[@]}"; do
    read_blocklist_file "${file}"
done

shopt -s nullglob
for directory in "${blocklist_dirs[@]}"; do
    for file in "${directory}"/*.list; do
        read_blocklist_file "${file}"
    done
done

count_entries() {
    local file="$1"
    local count

    count="$(wc -l < "${file}")"
    printf '%s' "${count//[[:space:]]/}"
}

calculate_maxelem() {
    local entry_count="$1"
    local minimum="$2"
    local autosized

    autosized=$((entry_count + ((entry_count + 3) / 4)))

    if (( autosized < minimum )); then
        printf '%s' "${minimum}"
    else
        printf '%s' "${autosized}"
    fi
}

write_restore_file() {
    local set_name="$1"
    local family="$2"
    local body_file="$3"
    local restore_file="$4"
    local entry_count
    local set_maxelem

    entry_count="$(count_entries "${body_file}")"
    set_maxelem="$(calculate_maxelem "${entry_count}" "${maxelem}")"

    printf 'create %s hash:net family %s maxelem %s\n' "${set_name}" "${family}" "${set_maxelem}" > "${restore_file}"
    cat "${body_file}" >> "${restore_file}"
    echo "Prepared ${set_name}: entries=${entry_count} maxelem=${set_maxelem}"
}

write_restore_file "${ipv4_set}" inet "${tmp_ipv4_body}" "${tmp_ipv4}"
write_restore_file "${ipv6_set}" inet6 "${tmp_ipv6_body}" "${tmp_ipv6}"

destroy_stale_temp_sets() {
    local set_name
    local pattern

    pattern="^(${ipv4_set}|${ipv6_set})_tmp_[0-9]+$"

    while IFS= read -r set_name; do
        [[ "${set_name}" =~ ${pattern} ]] || continue
        ipset destroy "${set_name}" >/dev/null 2>&1 || true
    done < <(ipset list -name 2>/dev/null || true)
}

destroy_stale_temp_sets

refresh_set() {
    local set_name="$1"
    local restore_file="$2"
    local source_pattern="${set_name//./\\.}"
    local temp_set="${set_name}_tmp_$$"

    ipset destroy "${temp_set}" >/dev/null 2>&1 || true

    if ipset list "${set_name}" >/dev/null 2>&1; then
        temp_sets+=("${temp_set}")
        sed -E "s/^((create|add)[[:space:]]+)${source_pattern}([[:space:]]|$)/\\1${temp_set}\\3/" "${restore_file}" \
            | ipset restore -exist
        ipset swap "${temp_set}" "${set_name}"
        ipset destroy "${temp_set}"
    else
        ipset restore -exist -file "${restore_file}"
    fi
}

refresh_set "${ipv4_set}" "${tmp_ipv4}"
refresh_set "${ipv6_set}" "${tmp_ipv6}"
