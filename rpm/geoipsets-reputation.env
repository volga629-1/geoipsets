# Local SIP reputation worker configuration.
#
# The worker reads Suricata EVE JSON and checks suspicious source IPs against
# local API providers. Confirmed bad IPs are added to blocked_ipv4/blocked_ipv6,
# active conntrack state is deleted, and the address is appended to learned.list.

EVE_FILE=/var/log/suricata/eve.json
STATE_DB=/var/lib/geoipsets/reputation/reputation.sqlite
LEARNED_LIST=/var/lib/geoipsets/blocklists/learned.list
ALLOW_LIST=/var/lib/geoipsets/blocklists/allow.list

BLOCK_IPV4_SET=blocked_ipv4
BLOCK_IPV6_SET=blocked_ipv6

# Space-separated SIP ports used to qualify Suricata events.
SIP_PORTS="5060 5061 5084 5086 5087 5088"

# Process Suricata alert events immediately. SIP parser events such as OPTIONS
# are rate-gated by SIP_EVENT_MIN_COUNT/SIP_EVENT_WINDOW before API lookup.
CHECK_ALERTS=1
CHECK_SIP_EVENTS=1
SIP_EVENT_METHODS="OPTIONS REGISTER INVITE"
SIP_EVENT_MIN_COUNT=2
SIP_EVENT_WINDOW=300

# Cache clean decisions for one day and block decisions for seven days.
CACHE_CLEAN_TTL=86400
CACHE_BLOCK_TTL=604800
API_TIMEOUT=6

# Set DRY_RUN=1 to log decisions without changing ipsets, conntrack, or files.
DRY_RUN=0

# IPQualityScore proxy/VPN/fraud check. Recommended for VPN/proxy/Tor signals.
# IPQS_API_KEY=
IPQS_STRICTNESS=1
IPQS_FRAUD_THRESHOLD=85
IPQS_BLOCK_PROXY=1
IPQS_BLOCK_VPN=1
IPQS_BLOCK_TOR=1
IPQS_BLOCK_RECENT_ABUSE=1
IPQS_BLOCK_BOT=1

# AbuseIPDB check endpoint. Recommended for reported-abuse confidence.
# ABUSEIPDB_API_KEY=
ABUSEIPDB_MAX_AGE_DAYS=90
ABUSEIPDB_CONFIDENCE_THRESHOLD=90
