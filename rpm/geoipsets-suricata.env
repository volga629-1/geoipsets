# geoipsets Suricata rule provisioning options.
#
# These values are read by update-geoipsets-suricata-rules.service.

# Keep this in sync with Suricata vars.port-groups.SIP_PORTS and the mirror.
SIP_PORTS="5060 5061 5084 5086 5087 5088"

# Extra arguments passed to geoipsets-provision-sip-suricata.
# Default behavior installs local geoipsets SIP rules, rebuilds Suricata rules,
# tests the Suricata config, and reloads Suricata on success.
GEOIPSETS_SURICATA_ARGS="--reload"

# To also restart the SIP mirror during scheduled rule updates, set:
# GEOIPSETS_SURICATA_ARGS="--mirror --reload"
# WAN_IF="ens18"
# MIRROR_IF="ifb-sip0"
# MIRROR_TYPE="dummy"
# MIRROR_QLEN="10000"

# Optional path overrides.
# SURICATA_YAML="/etc/suricata/suricata.yaml"
# SURICATA_UPDATE_YAML="/etc/suricata/update.yaml"
# RULES_SRC="/usr/share/geoipsets/suricata/local-sip.rules"
# RULES_DST="/var/lib/suricata/rules/local-sip.rules"
# RULES_BUNDLE="/var/lib/suricata/rules/suricata.rules"
